general {
  output_format = "i3bar"
  colors = true
  color_good = "#9ece6a"
  color_degraded = "#e0af68"
  color_bad = "#f7768e"
  interval = 5
}

order += "wireless _first_"
order += "ethernet _first_"
order += "battery all"
order += "cpu_usage"
order += "memory"
order += "disk /"
order += "tztime local"

wireless _first_ {
  format_up = "W: %essid %quality"
  format_down = "W: off"
}

ethernet _first_ {
  format_up = "E: %ip"
  format_down = ""
}

battery all {
  format = "BAT: %percentage %status"
  low_threshold = 15
  threshold_type = "percentage"
}

cpu_usage {
  format = "CPU: %usage"
}

memory {
  format = "MEM: %percentage_used"
  threshold_degraded = "20%"
  threshold_critical = "10%"
}

disk "/" {
  format = "DISK: %avail"
}

tztime local {
  format = "%a %d %b  %H:%M"
}
